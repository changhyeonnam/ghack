# Copy to .env (never commit the real one). Everything is optional; defaults run offline in mock mode.
GOOGLE_API_KEY=                      # Gemini API key from AI Studio. Presence switches llm_mode auto -> live.
LEDGERLENS_LLM_MODE=auto             # auto | live | cache_only | mock
LEDGERLENS_MODEL_FLASH=gemini-3.8-flash
LEDGERLENS_MODEL_PRO=gemini-3.8-flash   # budget default; gemini-3.1-pro-preview to upgrade heavy agents
LEDGERLENS_BUDGET_CAP_USD=5          # hard stop per process
LEDGERLENS_STORAGE=local             # local | gcp
# LEDGERLENS_GCS_BUCKET=ledgerlens-demo-docs
# GOOGLE_CLOUD_PROJECT=your-project
# LEDGERLENS_ADMIN_TOKEN=change-me   # protects POST /api/demo/seed when set
